# Copy to .env (gitignored). Every value here is a local-development placeholder.
KEELGATE_CP_DATABASE_URL=postgresql://kg_app:CHANGE_ME@localhost:5432/keelgate_cloud  # pragma: allowlist secret
KEELGATE_CP_OWNER_DATABASE_URL=postgresql://kg_owner:CHANGE_ME@localhost:5432/keelgate_cloud  # pragma: allowlist secret
KEELGATE_CP_SECRET_KEY=generate-a-long-random-string-of-at-least-32-chars
KEELGATE_CP_PUBLIC_URL=http://localhost:8000
KEELGATE_CP_DASHBOARD_URL=http://localhost:3000
# Stripe TEST MODE ONLY. The server refuses a non-test key. stripe-mock needs no account:
#   docker run -p 12111:12111 stripe/stripe-mock
KEELGATE_CP_STRIPE_API_KEY=sk_test_local
KEELGATE_CP_STRIPE_API_BASE=http://localhost:12111
KEELGATE_CP_STRIPE_WEBHOOK_SECRET=whsec_local_test_secret
