# Where the Keelgate Cloud control plane listens (server-side only; never sent to the browser).
CONTROL_PLANE_URL=http://localhost:8000

# The control plane URL an AGENT should use; shown in the onboarding snippet and used for the
# "Sign in with SSO" redirect (this one IS visible to the browser, so it must be a public URL).
NEXT_PUBLIC_CONTROL_PLANE_PUBLIC_URL=http://localhost:8000

# Set to "false" only when serving over plain http on a non-localhost host (not recommended).
# By default the session cookie is Secure in production builds.
# COOKIE_SECURE=true

# No telemetry.
NEXT_TELEMETRY_DISABLED=1
