# Keelgate — example environment. Copy to `.env` and fill in locally.
#   cp .env.example .env
# `.env` is gitignored. NEVER put a real secret in this file; it is committed.

# ---------------------------------------------------------------- runtime
KEELGATE_ENV=local              # local | dev | staging | prod
KEELGATE_LOG_LEVEL=INFO
# Tenant isolation is mandatory; every request is scoped to a tenant.
KEELGATE_TENANT_ID=local-dev

# Hard safety switch. v1 ships paper/simulation only — there is no live
# brokerage or real-money execution. Leave this false.
KEELGATE_ALLOW_LIVE_EXECUTION=false

# ---------------------------------------------------- datastores (make up)
# Local dev credentials from docker-compose.dev.yml; localhost only.
DATABASE_URL=postgresql://keelgate:keelgate@localhost:5432/keelgate  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------- policy engine
# OPA/Rego is the default decision point; Cedar is optional behind the same
# PolicyEngine interface.
KEELGATE_POLICY_ENGINE=opa      # opa | cedar
KEELGATE_OPA_URL=http://localhost:8181
KEELGATE_POLICY_PACK=finance_basic

# ------------------------------------------------------- observability
# Keelgate exports OTLP over HTTP (pip install 'keelgate[otlp]'). Jaeger from `make up` listens on 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=keelgate
OTEL_TRACES_EXPORTER=otlp
# Record prompt/response content on spans. Off by default: spans would
# otherwise carry untrusted model and tool text into your telemetry backend.
OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=false

# ------------------------------------------------------------ model keys
# Leave blank unless you are running a provider-backed example. Use
# keelgate.testing.FakeLLM in tests — never a live key in CI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local models need no key. Ollama: http://localhost:11434; vLLM (OpenAI-compatible): /v1.
KEELGATE_OLLAMA_URL=http://localhost:11434
KEELGATE_VLLM_URL=http://localhost:8000/v1
KEELGATE_LLM_PROVIDER=fake      # fake | anthropic | openai | google | ollama | vllm

# --------------------------------------------------- approvals / audit
# Where human-in-the-loop approval requests are delivered.
KEELGATE_APPROVAL_TRANSPORT=local
# The audit chain is an unkeyed SHA-256 hash chain: there is no audit key to configure.
# To catch truncation, anchor `AuditLog.head(tenant)` somewhere the writer cannot reach.
# Local approvals queue used by the `keelgate-approvals` CLI.
KEELGATE_APPROVALS_DB=.keelgate/approvals.sqlite

# --------------------------------------------------- cloud (ee/) only
STRIPE_API_KEY=
KEELGATE_CLOUD_CONTROL_PLANE_URL=
